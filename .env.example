# ── Qdrant ───────────────────────────────────────────────
# Set ONE of the two.
# Embedded local mode: a folder on disk, no server process. Only one process
# can open it at a time, so stop the backend before running scripts/ or eval/.
QDRANT_PATH=data/qdrant
# Or a Qdrant server (docker run -p 6333:6333 qdrant/qdrant, or Qdrant Cloud):
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=

# ── Language model (any OpenAI-compatible endpoint) ──────
# Changing model = changing these lines, nothing else.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-6-luna
# Optional JSON merged into every request, for model-specific parameters.
LLM_EXTRA_BODY={"reasoning_effort": "low"}
#
# DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-v4-flash
#   LLM_EXTRA_BODY=
# Local Ollama:
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen3.5:9b
#   LLM_EXTRA_BODY={"temperature": 0}
#
# The model also writes the appearance descriptions from product photos
# (scripts/generate_visual_descriptions.py), so it must accept image input
# when you run that script.

# ── Eval judge (optional) ────────────────────────────────
# eval/check_numbers.py uses these; each defaults to the LLM_* value.
# Pin them when comparing models so only the model under test changes.
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_API_KEY=sk-...
# JUDGE_MODEL=gpt-5.4-mini
# JUDGE_EXTRA_BODY={"reasoning_effort": "low"}

# ── Embedding (local sentence-transformers, no key) ──────
EMBED_MODEL=intfloat/multilingual-e5-small
VECTOR_SIZE=384
