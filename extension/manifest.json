{
  "manifest_version": 3,
  "name": "ShopSense — 视障购物助手",
  "version": "0.1.0",
  "description": "在亚马逊商品页上，用语音解读外观、聚合评论、并提示官方描述与评论的矛盾。",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "ShopSense 设置",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "activate-shopsense": {
      "suggested_key": { "default": "Alt+V", "mac": "Alt+V" },
      "description": "唤起 ShopSense 解读当前商品"
    }
  }
}
